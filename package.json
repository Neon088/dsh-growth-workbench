{
  "name": "dsh-growth-workbench",
  "version": "0.2.0",
  "type": "module",
  "description": "Growth workbench for DeepSeek Harness: conversation-header button + right-sidebar panels for new-media ops, ecommerce and marketing — accounts, topics, platform variants, calendar, metrics ledgers, products, feedback, campaigns, SOP, glossary and copy rules, all backed by your Obsidian vault.",
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:browser": "node test/browser-safety.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "verify": "node --check client.js && node --check index.js && node scripts/build-client.mjs --check && node test/no-undefined-refs.mjs client.js index.js lib && node test/run-tests.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "icon.svg",
    "README.md",
    "LICENSE",
    "install.mjs",
    "rollback.mjs",
    "run-rollback.bat"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "author": "Neon088",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neon088/dsh-growth-workbench.git"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "growth",
    "ecommerce",
    "marketing",
    "obsidian",
    "workbench"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
